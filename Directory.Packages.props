<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      The Umbraco version everything in this solution compiles against.
      The default is the lowest version the package supports (the 17 LTS floor); the nupkg's
      dependency range starts here and consuming sites float above it.
      CI overrides it to build and boot the test site on newer 17.x and 18.x:
        dotnet build -p:UmbracoVersion=18.1.1
      Release builds must use the default.
    -->
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">17.0.0</UmbracoVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Delivery" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
  </ItemGroup>
</Project>
