<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UserSecretsId>koben-structureddata-testsite</UserSecretsId>
    <!-- Backoffice assets arrive pre-compressed; letting dotnet compress them again corrupts them. -->
    <CompressionEnabled>false</CompressionEnabled>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <!--
      The default UmbracoVersion is the package's supported floor, which by design is the oldest 17.x
      and so always carries published advisories. They are the consuming site's concern, not this
      throwaway test site's, and would otherwise appear on every CI run for the floor job.
    -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Koben.Umbraco.StructuredData\Koben.Umbraco.StructuredData.csproj" />
  </ItemGroup>

</Project>
